{
  "name": "@ardurai/contracts",
  "version": "1.2.0",
  "description": "Shared wire contract for the Ardur AI content pipeline",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./zod": {
      "import": "./dist/zod.js",
      "types": "./dist/zod.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "zod": "^3"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "^22.10.0",
    "eslint": "9.39.4",
    "prettier": "3.8.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.61.0",
    "zod": "^3.24.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ardur",
    "content-pipeline",
    "contracts",
    "schema",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ArdurAI/ardur-contracts.git"
  }
}
